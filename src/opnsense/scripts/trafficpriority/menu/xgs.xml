<menu>
    <!--
        On an XGS appliance - os-xgs-npu installed - the page is in the XGS section, with the
        appliance's own pages (2026-10-25); the section has the name and attributes os-xgs-npu gives
        it, so the two menu files make one section. It sits in os-xgs-npu's order, which is OPNsense's
        own: the appliance's pages (10-45), the family's plugins by subject (50-58), Updates, Problem
        Reports and the tools (80-89), the logs (90-92), About (99). This one is 47: after Offloaded
        Flows (45), whose connections it marks, and before the family's other plugins, whose 50 to 58
        are all taken. place-menu.sh copies this file, or own.xml, to the model's Menu/Menu.xml.
    -->
    <XGS VisibleName="XGS" cssClass="fa fa-microchip fa-fw" order="35">
        <TrafficPriority order="47" VisibleName="Traffic Priority" cssClass="fa fa-arrow-up-wide-short fa-fw" url="/ui/trafficpriority"/>
    </XGS>
</menu>
